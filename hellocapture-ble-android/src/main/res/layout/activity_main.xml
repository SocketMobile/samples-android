<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingBottom="@dimen/activity_vertical_margin"
    android:paddingLeft="@dimen/activity_horizontal_margin"
    android:paddingRight="@dimen/activity_horizontal_margin"
    android:paddingTop="@dimen/activity_vertical_margin"
    tools:context="com.example.socketmobile.android.hellocaptureble.MainActivity">

    <TextView
        android:id="@+id/main_label_service_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="false"
        android:text="@string/label_service"
        android:textAppearance="@style/TextAppearance.AppCompat.Medium"
        app:fontFamily="sans-serif"
        />
    <TextView
        android:id="@+id/main_service_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignBaseline="@id/main_label_service_status"
        android:layout_alignParentEnd="true"
        android:layout_alignParentRight="true"
        android:textAppearance="@style/TextAppearance.AppCompat.Medium"
        app:fontFamily="sans-serif-condensed"
        tools:text="Ready"
        tools:textColor="#2AA324"
        />
    <View
        android:id="@+id/divider_service_status"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentLeft="true"
        android:layout_below="@+id/main_label_service_status"
        android:background="?android:attr/listDivider"
        />
    <Button
        android:id="@+id/discovery"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/divider_service_status"
        android:layout_marginTop="24dp"
        android:text="@string/action_add_device"
        android:visibility="visible"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/device_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/spinner_discovered_devices"
        android:layout_marginTop="12dp"/>

    <TextView
        android:id="@+id/label_select_device"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/discovery"
        android:layout_marginTop="12dp"
        android:textStyle="bold"
        android:textSize="15sp"
        android:textAppearance="@style/TextAppearance.AppCompat.Medium"
        app:fontFamily="sans-serif"
        android:text="@string/label_select_device" />

    <Spinner
        android:id="@+id/spinner_discovered_devices"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="5dp"
        android:layout_below="@+id/discovery"
        android:layout_toRightOf="@+id/label_select_device"
        android:layout_marginTop="12dp"/>

    <View
        android:id="@+id/divider_spinner"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentLeft="true"
        android:layout_below="@+id/device_list"
        android:layout_marginTop="12dp"
        android:background="?android:attr/listDivider"
        />

    <TextView
        android:id="@+id/hello_scan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/divider_spinner"
        android:layout_marginTop="12dp"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textAppearance="@style/TextAppearance.AppCompat.Medium"
        app:fontFamily="sans-serif"
        android:scrollbars = "vertical"
        android:ellipsize="end"
        android:text="@string/label_scan_data"/>

    <Button
        android:id="@+id/btn_clear_data"
        style="@style/Widget.Socket.Button.Outlined"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/action_clear_data"
        android:layout_below="@+id/divider_spinner"
        android:layout_alignParentRight="true"
        android:layout_marginTop="8dp"
        />

</RelativeLayout>
