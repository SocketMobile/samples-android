<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.MaterialComponents.Light.DarkActionBar">
        <!-- Socket Mobile brand blue on a Material Components base -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryDark</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSecondary">@color/colorPrimary</item>
        <item name="colorSecondaryVariant">@color/colorPrimaryDark</item>
        <item name="colorOnSecondary">@android:color/white</item>
        <!-- legacy AppCompat attributes -->
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <!-- sentence-case, pill-cornered buttons app-wide -->
        <item name="materialButtonStyle">@style/Widget.Socket.Button</item>
    </style>

    <!-- Filled primary button: brand blue, sentence case, rounded -->
    <style name="Widget.Socket.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">20dp</item>
    </style>

    <!-- Secondary action: outlined blue (light-blue stroke, brand-blue text) -->
    <style name="Widget.Socket.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">20dp</item>
        <item name="strokeColor">#C4D6F5</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Device-row action chip: light-blue fill, brand-blue text -->
    <style name="Widget.Socket.Button.Tonal" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">20dp</item>
        <item name="backgroundTint">#E8F0FF</item>
        <item name="strokeColor">#C4D6F5</item>
        <item name="strokeWidth">1dp</item>
    </style>

</resources>
