<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required to reach the Capture service over local HTTP. capture-android ships
         this permission in its AAR manifest; the plain Java SDK is a bare JAR, so the
         app must declare it itself. Without it, socket() fails with EPERM. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Lets this app see and launch the Socket Mobile Companion on Android 11+ -->
    <queries>
        <package android:name="com.socketmobile.companion" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- No com.socketmobile.capture.APP_KEY / DEVELOPER_ID meta-data here:
             with the plain Java SDK the credentials are passed programmatically
             (see MainActivity). -->
        <activity
            android:name="com.example.socketmobile.android.hellocaptureplainjava.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
