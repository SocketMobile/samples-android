<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.MaterialComponents.Light.DarkActionBar">
        <!-- Socket Mobile brand blue on a Material Components base -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryDark</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSecondary">@color/colorPrimary</item>
        <item name="colorSecondaryVariant">@color/colorPrimaryDark</item>
        <item name="colorOnSecondary">@android:color/white</item>
        <!-- legacy AppCompat attributes -->
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <!-- sentence-case, pill-cornered buttons app-wide -->
        <item name="materialButtonStyle">@style/Widget.Socket.Button</item>
    </style>

    <!-- Filled primary button: brand blue, sentence case, rounded -->
    <style name="Widget.Socket.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">20dp</item>
    </style>

    <!-- Secondary action: outlined blue (light-blue stroke, brand-blue text) -->
    <style name="Widget.Socket.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">20dp</item>
        <item name="strokeColor">#C4D6F5</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Device-row action chip: light-blue fill, brand-blue text -->
    <style name="Widget.Socket.Button.Tonal" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">20dp</item>
        <item name="backgroundTint">#E8F0FF</item>
        <item name="strokeColor">#C4D6F5</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="layout_ww">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="btn_socketcam_statue">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="textAllCaps">false</item>
    </style>

    <!-- SocketCam viewfinder buttons: brand-blue filled, matching the app's primary button -->
    <style name="btn_trigger" parent="Widget.Socket.Button" />

    <style name="property_text_base">
        <item name="android:textAppearance">@style/TextAppearance.AppCompat.Small</item>
        <item name="fontFamily">sans-serif</item>
    </style>

    <style name="txt_property_name" parent="property_text_base">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginTop">8dp</item>
    </style>

    <style name="txt_property_desc" parent="property_text_base">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="layout_constraintEnd_toEndOf">parent</item>
    </style>

    <style name="view_property_divider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">#888</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:layout_marginBottom">4dp</item>
    </style>

</resources>
